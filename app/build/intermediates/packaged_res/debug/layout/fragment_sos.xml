<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal"
    android:background="@color/background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Emergency SOS Alert"
        android:textColor="@color/slate_900"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSosCountdownText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sending in 5s. Pick what's happening:"
        android:textColor="@color/slate_600"
        android:textSize="14sp"
        android:layout_marginTop="8dp" />

    <!-- Big SOS Panic Button Ring -->
    <RelativeLayout
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginTop="24dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/primary" />

        <TextView
            android:id="@+id/tvSosCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="5"
            android:textColor="@color/white"
            android:textSize="64sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <RadioGroup
        android:id="@+id/rgSosType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">

        <RadioButton
            android:id="@+id/rbMedical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Medical Emergency"
            android:checked="true"
            android:padding="12dp" />

        <RadioButton
            android:id="@+id/rbFall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accident / Fall"
            android:padding="12dp" />

        <RadioButton
            android:id="@+id/rbSafety"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Personal Safety / Danger"
            android:padding="12dp" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/btnCancelSos"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="@color/slate_800"
            android:backgroundTint="@color/slate_200"
            android:layout_marginEnd="8dp"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/btnSendSosNow"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Send Now"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary"
            android:layout_marginStart="8dp"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnCallPolice"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Call Police (999 / 112)"
        android:textColor="@color/white"
        android:backgroundTint="@color/emergency_danger"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:cornerRadius="16dp" />

</LinearLayout>
